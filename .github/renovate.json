{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "schedule": ["* 0-7 * * 6"],
  "timezone": "Asia/Tokyo",
  "labels": ["dependencies"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "rangeStrategy": "bump",
  "git-submodules": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": [".github/workflows/*.yml"],
      "matchStrings": [
        "jobs.*.strategy.matrix.platform[label].{\"depName\": $substringBefore(label, \"-\"), \"currentValue\": $substringAfter(label, \"-\")}",
        "jobs.*.strategy.matrix.exclude.platform[label].{\"depName\": $substringBefore(label, \"-\"), \"currentValue\": $substringAfter(label, \"-\")}",
        "jobs.*.strategy.matrix.include.platform[label].{\"depName\": $substringBefore(label, \"-\"), \"currentValue\": $substringAfter(label, \"-\")}"
      ],
      "datasourceTemplate": "github-runners"
    },
    {
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": [".github/workflows/*.yml"],
      "matchStrings": [
        "jobs.*.steps[$contains(uses, /^golangci\\/golangci-lint-action/)].{\"currentValue\": with.version}"
      ],
      "packageNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": [".custom-gcl.yml"],
      "matchStrings": [
        "{\"currentValue\": version}"
      ],
      "packageNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "addLabels": ["docker"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github_actions"]
    },
    {
      "matchDatasources": ["github-runners"],
      "addLabels": ["github_actions"]
    },
    {
      "matchManagers": ["gomod"],
      "addLabels": ["go"]
    },
    {
      "matchDepNames": ["go", "golang"],
      "groupName": "go",
      "minimumGroupSize": 2,
      "rangeStrategy": "auto"
    },
    {
      "matchDepNames": ["*"],
      "commitMessageAction": "Bump",
      "commitMessageExtra": "",
      "commitMessageSuffix": "from {{currentVersion}} to {{newVersion}}",
      "commitMessageTopic": "{{depName}}"
    }
  ]
}
